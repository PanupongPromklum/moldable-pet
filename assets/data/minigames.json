{
  "_meta": {
    "owner": "loop",
    "story": "S2-07, S5-01",
    "version": 2,
    "doc": "design/gdd/minigame-snack-rain.md, design/gdd/minigames-2.md",
    "units": {
      "durationSec / countdownSec / graceSec / rampSec / grumpySec / pauseResumeCountdownSec": "seconds",
      "lanesOrWidth": "< 2 = continuous movement, value is the play width as a fraction of the visible width at the pet's depth; integer >= 2 = that many lanes",
      "playWidthMaxUnits / catchRadius / itemSize": "world units (1 = prototype body radius)",
      "spawn.*PerSec": "objects spawned per second",
      "spawn.rampPower": "curve exponent on round progress p (0..1): 1 = linear, > 1 = slow start",
      "fallSpeed.*": "visible play heights per second (screen-relative, same feel on phone and desktop)",
      "move.keySpeed": "play widths per second while an arrow key is held",
      "move.followPerSec": "smoothing rate toward the pointer/hand target, 1/s (higher = snappier)",
      "items.*.weight": "relative spawn weight; demon weight ramps from 0 after graceSec over rampSec",
      "items.*.points": "score per catch, before the streak multiplier (demon points are a flat penalty, not multiplied)",
      "streak.step": "consecutive catches per multiplier step",
      "coinsPerPoints": "points per 1 bonus coin at round end (floor)",
      "needs.*": "need level delta (0..1 scale) on round end, scaled by the fraction of the round played; fun also x persona playGain",
      "picker.favoriteFunScale": "multiplier on round-end fun for the character's favourite game (no extra coins)",
      "picker.firstPlayEasySec / lineCooldownSec": "seconds",
      "mimic.*Sec": "seconds; showSec lerps showStartSec -> showEndSec between startLength and showRampLength",
      "mimic.startLength / maxLength / showRampLength / pads.*": "poses (sequence length or pad count)",
      "mimic.slipReplaySlow / relaxed.showScale": "multiplier on showSec",
      "mimic.hintScale": "multiplier on a sequence's points when the hint flashed",
      "mimic.coinsPerPoints / bubbles.coinsPerPoints / hop.coinsPerPoints": "points per 1 coin at round end (floor)",
      "bubbles.spawn.*PerSec": "bubbles per second; rise.* = visible play heights per second; drift = play widths sway",
      "bubbles.bubbleSize / popStar.radius": "world units; hitScale = multiplier on the tap radius",
      "bubbles.targetShare / coinShare": "0..1 share of spawned bubbles",
      "bubbles.call.*Sec": "seconds; minOnScreen = bubbles of the called colour guaranteed after a call",
      "bubbles.popStar.y": "fraction of play height from the bottom; keySpeed = play widths per second",
      "hop.petX": "fraction of play width from the left",
      "hop.jump.airSec / doubleAirSec / bufferSec": "seconds; height = world units",
      "hop.spawn.gap*Sec": "seconds between obstacles; gapJitter = +- fraction; minGapAir = multiple of airSec",
      "hop.speed.*": "world units per second",
      "hop.spawn.kinds / doubles.share / coinShare": "relative weights / 0..1 chance",
      "hop.headFlick.*Deg": "head roll degrees from neutral; withinSec = seconds",
      "hop.headMode.* / relaxed.speedScale": "multipliers",
      "*.points.* / pointsPerPose": "score per event before the streak multiplier; coinValue = coins per coin pickup",
      "*.lines.*": "personas.json line event ids"
    }
  },
